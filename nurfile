# Dev tasks for lsdocs-render-html (run with `nur`; `nur --list` shows them).
# The tasks shared by every lsdocs repository come first; this
# repository's own follow.

use scripts/org.nu
use scripts/org.nu run-cmd

# The organization's repositories and their crates (for `check-git-deps`
# and `link`).
def org-map []: nothing -> record { open scripts/org.nuon }

# Runs cargo with `org-env` (local clones when LSDOCS_ORG_DIR is set).
# PYO3_BUILD_EXTENSION_MODULE builds pyo3 crates as extension modules (no
# libpython link), as maturin does, so plain cargo builds of them work.
def --wrapped cargo-org [...args] {
    with-env ((org org-env) | insert PYO3_BUILD_EXTENSION_MODULE "1") { run-cmd cargo ...$args }
}

# cargo-org, for output that is captured (no `run-cmd` lines in it).
def --wrapped cargo-org-out [...args] {
    with-env ((org org-env) | insert PYO3_BUILD_EXTENSION_MODULE "1") { ^cargo ...$args }
}

# Format the Rust code (`--check` only checks).
def "nur fmt" [--check] {
    if $check { run-cmd cargo fmt --all -- --check } else { run-cmd cargo fmt --all }
}

# Clippy, warnings as errors.
def "nur lint" [] {
    cargo-org clippy --workspace --all-targets -- -D warnings
}

# The Rust tests.
def "nur test" [] {
    cargo-org test --workspace
}

# Fails if a crate of the organization is built twice (two sources, or a
# `[patch]` applied on one side only).
def "nur check-dupes" [] {
    let found = org tree-dupes (cargo-org-out tree --workspace --duplicates -e normal,build,dev | complete)
    if ($found | is-not-empty) {
        error make --unspanned {msg: $"built twice: ($found | str join ', ')"}
    }
    print "check-dupes: OK"
}

# Fails unless every lsdocs dependency is a path inside this repository or
# a git dependency on the organization repository holding it.
def "nur check-git-deps" [] {
    let manifests = glob "{Cargo.toml,crates/*/Cargo.toml,bindings/*/Cargo.toml,tools/*/Cargo.toml}"
    let errors = $manifests | each {|m|
        let dir = $m | path dirname | path relative-to $env.PWD | str replace --all '\' '/' | if $in == "" { "." } else { $in }
        org check-git-deps (open $m) (org-map) --dir $dir | each {|e| $"($m): ($e)" }
    } | flatten
    if ($errors | is-not-empty) {
        for e in $errors { print -e $"error: ($e)" }
        error make --unspanned {msg: "check-git-deps failed"}
    }
    print $"check-git-deps: ($manifests | length) manifest\(s\) OK"
}

# Builds against a local checkout of an organization repository (live
# edits, committed or not): writes `[patch]` entries into the untracked
# .cargo/config.toml. `nur unlink` undoes it.
def "nur link" [path: string] {
    let name = $path | path expand | path basename
    let crates = org-map | get -o $name
    if $crates == null { error make --unspanned {msg: $"`($name)` is not a repository of the organization"} }
    mkdir .cargo
    let file = ".cargo/config.toml"
    let config = if ($file | path exists) { open $file } else { {} }
    let patch = $config | get -o patch | default {} | upsert $"($org.ORG_URL)/($name)" (org patch-entries $path $crates)
    $config | upsert patch $patch | to toml | save -f $file
    print $"linked ($name) -> ($path | path expand)"
}

# Removes `nur link`'s entries (all, or one repository's).
def "nur unlink" [name?: string] {
    let file = ".cargo/config.toml"
    if not ($file | path exists) { return }
    let config = open $file
    let patch = if $name == null { {} } else { $config | get -o patch | default {} | reject -o $"($org.ORG_URL)/($name)" }
    $config | upsert patch $patch | to toml | save -f $file
}

# Checks each crate on its own `rust-version` (installing the toolchains),
# without default features, then the workspace on the highest one.
def "nur msrv" [] {
    let groups = (
        cargo-org-out metadata --no-deps --format-version 1 | from json | get packages
        | select name rust_version | group-by rust_version
        | transpose version crates
        | sort-by {|g| $g.version | split row "." | each { into int } | $in.0 * 1000 + $in.1 }
    )
    for group in $groups {
        run-cmd rustup toolchain install $group.version --profile minimal --no-self-update
        let names = $group.crates | get name
        print $"Rust ($group.version): ($names | str join ', ')"
        cargo-org $"+($group.version)" check --no-default-features ...($names | each {|n| [-p $n] } | flatten)
    }
    let highest = $groups | last | get version
    print $"Rust ($highest): the workspace, default features"
    cargo-org $"+($highest)" check --workspace
}

# Licenses, advisories and sources of the dependencies (.config/deny.toml).
# mise installs cargo-deny on first use (.config/mise.deny.toml).
def "nur deny" [] {
    with-env ((org org-env) | insert MISE_ENV deny) { run-cmd mise exec cargo:cargo-deny -- cargo deny check }
}

# Updates the lockfile's revision of organization crates (all, or one).
def "nur bump" [crate?: string] {
    if $crate == null { cargo-org update } else { cargo-org update -p $crate }
}

# Environment for running Node.js from mise (.node-version) when `node` is
# not already on PATH (an activated mise puts it there). Only PATH: mise's
# other variables (a global RUSTUP_TOOLCHAIN, say) would override the
# repository's own.
def node-env []: nothing -> record {
    if (which node | is-not-empty) { return {} }
    if (which mise | is-empty) {
        error make --unspanned {msg: "Node.js not found: install mise, then run `mise install`"}
    }
    run-cmd mise install --quiet node
    # A string: nur does not convert list-valued PATH for children.
    {PATH: (^mise env --json | from json | get PATH)}
}

# Installs a Node package's dependencies, again whenever the platform
# changes: node_modules holds platform-specific packages, and the checkout
# may be shared between platforms (e.g. Windows and WSL).
def npm-install []: nothing -> nothing {
    let marker = "node_modules/.lsdocs-platform"
    let platform = $"($nu.os-info.name)-($nu.os-info.arch)"
    if not ($marker | path exists) or (open --raw $marker | str trim) != $platform {
        run-cmd npm ci --no-fund --no-audit --loglevel=error
        $platform | save --force $marker
    }
}

# The default theme: its TypeScript sources (an npm package for TypeScript
# and the signals library, never shipped) and its compiled modules, which
# are checked in so building a site needs no Node.js.
const THEME = "crates/render-html/themes/default"

# The vendored signals library: from node_modules (the version
# package.json pins) to src/vendor, without its source map comment (the
# map is not shipped).
def theme-vendor [src: string, vendor: string]: nothing -> nothing {
    let pkg = $src | path join node_modules @preact signals-core
    mkdir $vendor
    open --raw ($pkg | path join dist signals-core.mjs)
    | str replace --regex '//# sourceMappingURL=\S*\s*$' ''
    | save --raw --force ($vendor | path join signals-core.mjs)
    cp --force ($pkg | path join dist signals-core.d.ts) ($vendor | path join signals-core.d.mts)
    cp --force ($pkg | path join LICENSE) ($vendor | path join LICENSE)
}

# Compile the theme's TypeScript (run from src/, Node.js on PATH) into
# `out`, a fresh directory, beside the vendored modules and their license.
def theme-compile [src: string, out: string]: nothing -> nothing {
    rm --recursive --force $out
    run-cmd node ($src | path join node_modules typescript bin tsc) --project $src --outDir $out
    mkdir ($out | path join vendor)
    cp --force ($src | path join vendor signals-core.mjs) ($out | path join vendor signals-core.mjs)
    cp --force ($src | path join vendor LICENSE) ($out | path join vendor LICENSE.txt)
}

# A directory's files, by path relative to it, with their contents' hash.
def dir-digest [dir: string]: nothing -> table {
    if not ($dir | path exists) { return [] }
    glob --no-dir ($dir | path join "**" "*" | str replace --all '\' '/')
    | each {|f| {path: ($f | path relative-to $dir | str replace --all '\' '/'), hash: (open --raw $f | hash sha256)} }
    | sort-by path
}

# Regenerate the default theme's scripts (its assets/js/, and the vendored
# signals library in src/vendor/) from its TypeScript sources (needs
# Node.js, or fnm). Review the diff.
def "nur gen theme" [] {
    let src = $env.PWD | path join $THEME src
    cd $src
    with-env (node-env) {
        npm-install
        theme-vendor $src ($src | path join vendor)
        theme-compile $src ($env.PWD | path join .. assets js)
    }
}

# Type-check and compile the default theme's TypeScript, fail if the
# checked-in scripts (or the vendored library) are stale, and run the
# theme's tests (needs Node.js, or fnm).
def "nur test theme" [] {
    let root = $env.PWD
    let src = $root | path join $THEME src
    let assets = $root | path join $THEME assets js
    let check = cargo metadata --format-version 1 --no-deps | from json | get target_directory | path join theme-check
    cd $src
    with-env (node-env) {
        npm-install
        theme-vendor $src ($check | path join vendor)
        if (dir-digest ($check | path join vendor)) != (dir-digest ($src | path join vendor)) {
            error make --unspanned {msg: $"($THEME)/src/vendor is stale: run `nur gen theme`"}
        }
        theme-compile $src ($check | path join js)
        if (dir-digest ($check | path join js)) != (dir-digest $assets) {
            error make --unspanned {msg: $"($THEME)/assets/js is stale: run `nur gen theme`"}
        }
        cd ($root | path join $THEME)
        # Node.js warns that its localStorage needs a file: the tests check
        # the theme copes without one.
        run-cmd node --disable-warning=ExperimentalWarning --test test/
    }
}

# Decode every MessagePack fixture with nushell and compare to its JSON twin.

# What CI runs.
def "nur ci" [] {
    nur fmt --check
    nur lint
    nur test
    nur test theme
    nur check-dupes
    nur check-git-deps
}
